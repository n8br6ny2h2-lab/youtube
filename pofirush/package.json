{
  "name": "pofi-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Pofi Rush — sonsuz, zor, tek dokunuşlu kanat çırpma oyunu (HTML5 + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8090",
    "build": "node scripts/build.mjs",
    "assets": "node scripts/make-assets.mjs && npx @capacitor/assets generate --iconBackgroundColor '#1b1035' --splashBackgroundColor '#1b1035'",
    "native:init": "npm run build && npx cap add android && npx cap add ios && node scripts/patch-native.mjs && npm run assets",
    "patch": "node scripts/patch-native.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "test": "node scripts/smoke-test.mjs",
    "validator": "node server/validate.mjs",
    "web": "node scripts/bundle-web.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "cordova-plugin-purchase": "^13.20.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "esbuild": "^0.25.12"
  }
}
