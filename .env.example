# Kopyalayın: cp .env.example .env  — .env git'e girmez.
# Boş bırakılan servisler otomatik olarak ücretsiz/yerel alternatife düşer.

# Claude API (hikâye, senaryo, fikir puanlama). Boşsa yerel şablon motoru kullanılır.
ANTHROPIC_API_KEY=

# OpenAI (isteğe bağlı, şu an yalnızca yedek LLM olarak)
OPENAI_API_KEY=

# ElevenLabs (isteğe bağlı, daha doğal seslendirme). Boşsa Piper (yerel, ücretsiz).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Stok medya (isteğe bağlı; karakterler/arka planlar zaten özgün vektör olarak üretiliyor)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# YouTube araştırma için (OAuth yoksa) basit API anahtarı
YOUTUBE_API_KEY=

# Google OAuth istemci dosyası (Google Cloud Console > Credentials > OAuth client ID > Desktop app)
GOOGLE_CLIENT_SECRET_FILE=config/secrets/client_secret.json
GOOGLE_TOKEN_FILE=config/secrets/token.json

# Yönetim paneli ve n8n tetikleyicileri için ortak gizli anahtar (rastgele uzun bir değer)
DASHBOARD_TOKEN=change-me
