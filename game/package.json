{
  "name": "efsun-avcisi",
  "version": "1.2.0",
  "private": true,
  "description": "Efsun Avcısı — mobil aksiyon RPG (HTML5 + Capacitor)",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "build": "node scripts/build.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "server": "cd server && npm install && npm run cloud",
    "native-setup": "node scripts/native-setup.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "cordova-plugin-purchase": "^13.20.0",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
